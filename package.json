{
  "name": "antigravity-community-marketplace",
  "displayName": "Community Plugin Marketplace: A plugin for Google Antigravity App",
  "version": "1.0.6",
  "description": "Browse, audit, install, and update community-made Antigravity App plugins.",
  "type": "module",
  "license": "MIT",
  "author": "Phillip Webber <github@webbsense.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Domush/antigravity-community-marketplace.git"
  },
  "bugs": {
    "url": "https://github.com/Domush/antigravity-community-marketplace/issues"
  },
  "homepage": "https://github.com/Domush/antigravity-community-marketplace#readme",
  "keywords": [
    "antigravity",
    "antigravity-plugin",
    "gemini",
    "marketplace",
    "plugin-manager",
    "security-audit",
    "mcp",
    "model-context-protocol",
    "ed25519"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "build:ui": "vite build --config ui/vite.config.js",
    "prepack": "npm run build:ui",
    "prepublishOnly": "npm run build:ui && npm test",
    "test": "node --test ./tests/*.test.mjs"
  },
  "bin": {
    "antigravity-community-marketplace": "server/index.mjs"
  },
  "main": "./server/index.mjs",
  "files": [
    "plugin.json",
    "icon.svg",
    "mcp_config.json",
    "server/",
    "sidecars/",
    "ui/dist/marketplace.html",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "tar-stream": "^3.1.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
